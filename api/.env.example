# development | staging | production
APP_ENV=development
FLASK_APP=wsgi:app
FLASK_DEBUG=1

# --- Database ---------------------------------------------------------------
# Local:  postgresql+psycopg://marines:marines@localhost:5432/marines_dev
# Render: the Internal Database URL, rewritten to the psycopg3 driver
DATABASE_URL=postgresql+psycopg://marines:marines@localhost:5432/marines_dev

# --- Secrets ----------------------------------------------------------------
# Generate each: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-every-environment
JWT_SECRET_KEY=change-me-and-keep-it-different-from-secret-key

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
JWT_COOKIE_SECURE=0

# --- CORS -------------------------------------------------------------------
# Comma-separated exact origins. No wildcards, ever.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ----------------------------------------------------------
# memory:// suits a single Render instance; swap to redis:// when scaling out.
RATELIMIT_STORAGE_URI=memory://

# --- Media storage ----------------------------------------------------------
# local | cloudinary
MEDIA_BACKEND=local
MEDIA_LOCAL_DIR=uploads
MEDIA_MAX_UPLOAD_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Club bootstrap ---------------------------------------------------------
# Used once to create the first Club Admin. Unset afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
